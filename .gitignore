# Secretos. `*.local` cubre .env.local, que es donde vive la cadena de conexión
# a Postgres. Nunca debe salir de la máquina.
*.local
.env
.env.*
!.env.example

node_modules
dist
dist-ssr

# Serie de métricas local. Desde F2-01 el registro que manda es la tabla
# `ingest_runs`; este archivo es el respaldo de cada instancia y no se comparte.
data/

# Material de referencia de terceros. Se queda en local: es trabajo ajeno y este
# repositorio es público.
*.docx
*.zip
temp_extracted/

# Documentos internos de ingeniería y de negocio. No son contenido del sitio y
# no aportan nada a quien clone el repositorio; la auditoría además describe con
# detalle fallas del sistema, y no hay razón para servírselas a nadie en bandeja.
# Lo que SÍ es público vive en doblefoco-app/src/docs/metodologia.txt y
# catalogo_medios.txt, que se importan en la página /nosotros.
ANALISIS_EXHAUSTIVO.txt
PLANTILLA_SOLICITUD_PATROCINIO.md
doblefoco-app/src/docs/plantilla_solicitud_patrocinio.md
doblefoco-app/src/docs/plan_motor.txt
doblefoco-app/src/docs/loop_ingestion_doc.txt

