# Copia este archivo a .env.local y ajusta los valores.
# .env.local está en .gitignore: nunca subas secretos al repositorio.

# --- Frontend (se incrustan en el bundle: TODO lo que empiece por VITE_ es PÚBLICO) ---

# URL base de la API. Si se deja vacía, el cliente construye rutas RELATIVAS
# (`/api/...`), y en desarrollo eso es lo que se quiere: `vite.config.js` tiene
# un proxy que manda `/api` a la API real.
#
# PARA DESARROLLAR, PON `same-origin`.
#
#   · `same-origin`  ->  el navegador pide a SU PROPIO origen y el proxy de
#     `vite.config.js` reenvía. No hay cross-origin, así que no hay CORS que
#     permitir. ESTO es lo que se quiere para desarrollar.
#   · Vacía  ->  modo demostración: no se intenta NINGUNA petición y el sitio se
#     dibuja con el catálogo local. Es un estado legítimo, y por eso vacío no
#     significa «mismo origen».
#   · Con la URL de producción puesta  ->  el navegador pide a otro origen, la
#     API solo permite el de producción, y TODAS las llamadas mueren en la CORS.
#     Lo que se ve entonces no es un fallo del código: es la página vacía con
#     los contadores en cero. Es un diagnóstico falso esperando a que alguien lo
#     crea, y el 2026-08-24 estuvo a punto de colar.
#
# Para apuntar el proxy a otro sitio —por ejemplo al servidor local mientras se
# toca el backend—:  API_DEV=http://localhost:5000 npm run dev
#
# En producción (Vercel) vale https://doblefoco.fly.dev, y sale de `vercel.json`,
# no de aquí. Ese origen tiene que estar en connect-src de la CSP, en
# vercel.json Y en public/_headers. Si no, el navegador bloquea las peticiones
# sin dar error de red: feed vacío y nada más que un aviso en la consola.
VITE_API_URL=same-origin

# NOTA: aquí ya no hay ninguna variable de acceso al panel.
#
# Hubo dos, VITE_ADMIN_PASSPHRASE y VITE_INGEST_TOKEN, y se retiraron en F2-04 y
# F2-05. Ambas eran públicas por construcción: TODO lo que empieza por VITE_ se
# incrusta en el bundle que se descarga el navegador. Se leían con abrir las
# herramientas de desarrollo.
#
# El acceso al panel lo dan ahora las cuentas de la tabla admin_users:
#   npm run admin:create -- correo@ejemplo.co
# y la sesión viaja en una cookie httpOnly que el JavaScript no puede leer.

# --- Backend (NO se exponen al navegador) ---

PORT=5000

# Orígenes autorizados para llamar a la API, separados por coma.
ALLOWED_ORIGINS=http://localhost:5173

# Intervalo del ciclo automático de ingesta, en milisegundos.
# Lo lee EL MOTOR (npm run worker), no la API. En producción son 30 min: cada
# feed solo expone sus últimos 15 titulares y un medio activo puede publicar más
# de 15 en una hora. Los que se pierdan no vuelven.
INGEST_INTERVAL_MS=600000

# Ingesta dentro del proceso de la API. Déjalo en false.
#
# Ya no hace ingesta ninguna: el motor vive en su propio proceso con su propio
# reloj (npm run worker). Lo único que sigue controlando es si la API rehidrata
# el corpus completo al arrancar, cosa que solo necesita quien agrupa.
# En producción, en false, la API arranca en 1,65 s y se queda en 74 MB.
INGEST_IN_PROCESS=false


# Saltos de proxy en los que confiar para deducir la IP real del cliente.
# Importa para el límite de intentos de inicio de sesión: si el servidor ve
# siempre la IP del proxy, ocho intentos de cualquiera bloquearían a todo el
# mundo. 1 es lo correcto detrás de un único proxy (Vercel, Fly, Railway).
TRUST_PROXY_HOPS=1

# --- Base de datos (tarea F2-01) ---
#
# OPCIONAL. Sin esto el sistema arranca igual, con los artículos en memoria, y
# un reinicio los borra: el arranque lo advierte por consola.
#
# Postgres gestionado (Supabase o Neon). Con Supabase, copia la cadena del
# "Session pooler", no la "Direct connection": los proyectos nuevos no tienen
# IPv4 en la conexión directa y desde muchas redes eso da un ENETUNREACH que
# parece un problema de credenciales sin serlo.
#
# Después de configurarla:  npm run db:migrate
DATABASE_URL=

# Certificado de la autoridad del servidor. Sin esto la conexión va cifrada
# pero NO se verifica la identidad del servidor: protege del espionaje pasivo,
# no de un intermediario activo. En producción debe estar puesto.
#
# El de Supabase viene incluido en el repositorio —es público, no un secreto—
# así que basta con descomentar la línea. Se descarga también desde
# Project Settings → Database → SSL Configuration.
#
# OJO: este certificado SUSTITUYE al almacén de confianza del sistema, no se
# añade. Es deliberado: solo se acepta la autoridad de Supabase, así que ni una
# autoridad pública comprometida podría suplantar a la base. Si algún día deja
# de conectar tras un cambio del proveedor, quita esta línea.
DATABASE_CA_CERT=./certs/supabase-prod-ca-2021.crt

# Conexiones máximas del pool. Ojo con el plan gratuito de Supabase, que tiene
# un techo bajo y compartido con el resto de tus servicios.
DATABASE_POOL_MAX=8
