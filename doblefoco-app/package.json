        "og:generar": "node scripts/generarOgImage.mjs",
        "backup": "node scripts/backup.mjs",
        "backup:restore": "node scripts/restore.mjs",
        "check:registry": "node scripts/checkRegistry.mjs",
    "check:comentarios": "node scripts/checkComentarios.mjs",
        "check:feeds": "node scripts/verifyFeeds.mjs",
        "feed:descubrir": "node scripts/descubrirFeed.mjs",
