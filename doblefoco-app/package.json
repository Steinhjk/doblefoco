{
  "name": "doblefoco-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file=.env.local server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "docs:catalog": "node scripts/generateCatalogDoc.mjs",
    "check:registry": "node scripts/checkRegistry.mjs",
    "check:feeds": "node scripts/verifyFeeds.mjs",
    "report:ingest": "node scripts/ingestReport.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "ingest:once": "node scripts/ingestOnce.mjs",
    "admin:create": "node scripts/createAdmin.mjs",
    "clean:filtered": "node scripts/cleanFiltered.mjs",
    "analyze:cocoverage": "node scripts/coCoverage.mjs",
    "eval:clustering": "node scripts/evalClustering.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.563.0",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^7.0.2",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
